{
  "name": "mozu-design",
  "version": "0.2.0",
  "private": true,
  "description": "RoomMuse: iPhone/iPad room scanner, the configurator website, and the 6-character scan handoff (local Node server or Vercel + Redis).",
  "scripts": {
    "start": "node scripts/build-web.js && node server/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "node scripts/build-web.js",
    "viewer": "npm run dev -w apps/configurator",
    "test:viewer": "npm test -w apps/configurator",
    "serve": "node server/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/scan-sdk",
    "apps/configurator"
  ]
}
